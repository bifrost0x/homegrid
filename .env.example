# Optional Compose configuration: copy to .env beside docker-compose.yml.
# Native Go reads process environment variables, not this file automatically.
HOMEGRID_BIND_ADDRESS=127.0.0.1
HOMEGRID_PORT=8095
HOMEGRID_IMAGE=ghcr.io/bifrost0x/homegrid:latest
TZ=UTC
# To deliberately allow LAN access, change HOMEGRID_BIND_ADDRESS to 0.0.0.0.

# Native binary configuration (Compose fixes its internal binding separately):
HOMEGRID_LISTEN=127.0.0.1:8080
HOMEGRID_DATA_DIR=./data
# Set true when served behind HTTPS. Default false permits local HTTP setup.
HOMEGRID_SECURE_COOKIE=false
# Comma-separated proxy CIDRs. Empty means forwarded headers are ignored.
HOMEGRID_TRUSTED_PROXIES=
